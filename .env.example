# Register a client at https://anilist.co/settings/developer with
# `maru://auth` as the redirect URL, then put its numeric id here.
# Copy this file to `.env` — .env is gitignored, .env.example is not.
#
# The id is not a secret (it ships inside the APK), but keep it out of the
# public repo anyway so other builds are not attributed to this client for
# AniList's rate limiting. For EAS cloud builds set it as an environment
# variable instead:
#   npx eas env:create --name ANILIST_CLIENT_ID --value 12345 --environment production
#
# Do NOT add the AniList client *secret*. MARU uses the implicit grant, which
# needs only the id — see RELEASE.md.
ANILIST_CLIENT_ID=
