{
  "expo": {
    "name": "MARU",
    "slug": "maru",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "maru",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.maru.tracker",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "app.maru.tracker",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#7C86F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D12"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "extraProguardRules": "# Expo services are created reflectively from the generated\n# ExpoModulesPackageList.getServices() and looked up by interface type\n# (ConstantsModule calls appContext.service<ConstantsInterface>()). R8 cannot\n# see those call sites; minifying them away leaves Constants.expoConfig null,\n# which silently empties expo.extra.anilistClientId and breaks AniList sign-in.\n-keep class * implements expo.modules.kotlin.services.Service { *; }\n-keep class expo.modules.constants.** { *; }\n-keep class expo.modules.interfaces.** { *; }\n-keep interface expo.modules.interfaces.** { *; }\n-keep class expo.modules.ExpoModulesPackageList { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
